diff --git a/code/skin_urls.py b/code/skin_urls.py
index e60e19a..772a59d 100644
--- a/code/skin_urls.py
+++ b/code/skin_urls.py
@@ -1 +1,11 @@
-PRELOAD_URLS = []
+from django.http import HttpResponseRedirect
+from django.urls import re_path
+
+
+def pod_redirect(request, path=""):
+    return HttpResponseRedirect("https://foss-north.se/pod/" + path)
+
+
+PRELOAD_URLS = [
+    re_path(r"^pod/(?P<path>.*)$", pod_redirect),
+]
