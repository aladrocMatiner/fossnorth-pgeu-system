+#
+# Keycloak login (generic OIDC)
+#
+def oauth_login_keycloak(request):
+    base = settings.OAUTH['keycloak']['baseurl'].rstrip('/')
+
+    def _keycloak_auth_data(oa):
+        r = oa.get('{0}/protocol/openid-connect/userinfo'.format(base)).json()
+        return (
+            r.get('email', ''),
+            r.get('given_name', ''),
+            r.get('family_name', ''),
+        )
+
+    return _login_oauth(
+        request,
+        'keycloak',
+        '{0}/protocol/openid-connect/auth'.format(base),
+        '{0}/protocol/openid-connect/token'.format(base),
+        ['openid', 'profile', 'email'],
+        _keycloak_auth_data)
+
+
