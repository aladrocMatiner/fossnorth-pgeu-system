+KEYCLOAK_SUPERADMIN_ROLE = 'pgeu-superadmin'
+KEYCLOAK_GROUP_ROLES = {
+    'pgeu-invoice-manager': 'Invoice managers',
+    'pgeu-news-admin': 'News administrators',
+    'pgeu-membership-admin': 'Membership administrators',
+    'pgeu-election-admin': 'Election administrators',
+    'pgeu-accounting-manager': 'Accounting managers',
+}
+KEYCLOAK_ACCESS_ROLES = set(['pgeu-user', KEYCLOAK_SUPERADMIN_ROLE]) | set(KEYCLOAK_GROUP_ROLES.keys())
+KEYCLOAK_OWNED_GROUPS = set(KEYCLOAK_GROUP_ROLES.values())
+
+
+def _json_list(value):
+    if isinstance(value, list):
+        return [str(v) for v in value]
+    if isinstance(value, str) and value:
+        return [value]
+    return []
+
+
+def _decode_jwt_payload(token):
+    try:
+        payload = token.split('.')[1]
+        payload += '=' * (-len(payload) % 4)
+        decoded = base64.urlsafe_b64decode(payload.encode('ascii')).decode('utf-8')
+        return json.loads(decoded)
+    except Exception:
+        log.warning("Unable to decode Keycloak access token payload for role sync")
+        return {}
+
+
+def _keycloak_roles_from_token(token, client_id):
+    if not token:
+        return set()
+
+    payload = _decode_jwt_payload(token)
+    roles = set(_json_list(payload.get('pgeu_roles')))
+    roles.update(_json_list(payload.get('resource_access', {}).get(client_id, {}).get('roles')))
+    return roles
+
+
+def _sync_keycloak_roles(user, roles):
+    desired_staff = KEYCLOAK_SUPERADMIN_ROLE in roles
+    user.is_staff = desired_staff
+    user.is_superuser = desired_staff
+    user.save(update_fields=['is_staff', 'is_superuser'])
+
+    desired_groups = set(
+        group_name
+        for role_name, group_name in KEYCLOAK_GROUP_ROLES.items()
+        if role_name in roles
+    )
+    current_owned_groups = Group.objects.filter(name__in=KEYCLOAK_OWNED_GROUPS)
+    for group in current_owned_groups:
+        if group.name not in desired_groups:
+            user.groups.remove(group)
+
+    for group_name in sorted(desired_groups):
+        group, _created = Group.objects.get_or_create(name=group_name)
+        user.groups.add(group)
+
 
