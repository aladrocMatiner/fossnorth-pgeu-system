@@ -0,0 +1,602 @@
+from django.contrib.auth.models import User
+from django.db import IntegrityError, transaction
+
+import logging
+import re
+
+from postgresqleu.confreg.models import Conference, ConferenceRegistration, ConferenceSeries
+from postgresqleu.confsponsor.benefitclasses import get_benefit_id
+from postgresqleu.confsponsor.models import Sponsor, SponsorClaimedBenefit, SponsorScanner
+from postgresqleu.confwiki.models import Wikipage
+from postgresqleu.membership.models import Meeting, Member
+from postgresqleu.util.models import KeycloakIdentityBinding, KeycloakRoleGrant
+from postgresqleu.util.random import generate_random_token
+
+
+log = logging.getLogger(__name__)
+
+
+KEYCLOAK_SCOPED_ROLES = {
+    'pgeu-series-admin',
+    'pgeu-conference-admin',
+    'pgeu-conference-tester',
+    'pgeu-conference-talkvoter',
+    'pgeu-conference-staff',
+    'pgeu-conference-volunteer',
+    'pgeu-conference-checkin-processor',
+    'pgeu-wiki-viewer',
+    'pgeu-wiki-editor',
+    'pgeu-sponsor-manager',
+    'pgeu-sponsor-badge-scanner',
+    'pgeu-meeting-admin',
+}
+
+
+class KeycloakIdentityConflict(Exception):
+    pass
+
+
+def _single_user_for_email(email):
+    users = list(User.objects.select_for_update().filter(email__iexact=email)[:2])
+    if len(users) > 1:
+        raise KeycloakIdentityConflict('Multiple Django users have the verified Keycloak email')
+    return users[0] if users else None
+
+
+@transaction.atomic
+def get_keycloak_revocation_target(email, issuer, subject):
+    if not issuer or not subject:
+        return None, None
+
+    binding = KeycloakIdentityBinding.objects.select_for_update().select_related('user').filter(
+        issuer=issuer,
+        subject=subject,
+    ).first()
+    if binding is not None:
+        binding.save(update_fields=['last_seen_at'])
+        return binding.user, binding
+
+    users = list(User.objects.select_for_update().filter(email__iexact=email)[:2])
+    if len(users) != 1:
+        return None, None
+    user = users[0]
+    user_binding = KeycloakIdentityBinding.objects.select_for_update().filter(
+        issuer=issuer,
+        user=user,
+    ).first()
+    if user_binding is not None:
+        return None, None
+    return user, None
+
+
+def _validate_binding_pair(binding, user, issuer, subject):
+    if binding is None or binding.issuer != issuer:
+        raise KeycloakIdentityConflict('Keycloak identity binding is missing or has the wrong issuer')
+    if binding.subject != subject or binding.user_id != user.pk:
+        raise KeycloakIdentityConflict('Keycloak subject and Django user binding are ambiguous')
+
+
+def _require_active_user(user):
+    if not user.is_active:
+        raise KeycloakIdentityConflict('The bound Django user is inactive')
+
+
+@transaction.atomic
+def get_or_bind_keycloak_user(email, firstname, lastname, issuer, subject):
+    subject_binding = KeycloakIdentityBinding.objects.select_for_update().select_related('user').filter(
+        issuer=issuer,
+        subject=subject,
+    ).first()
+    email_user = _single_user_for_email(email)
+
+    if subject_binding is not None:
+        if email_user is not None and email_user.pk != subject_binding.user_id:
+            raise KeycloakIdentityConflict('Verified email belongs to a different bound Django user')
+        _require_active_user(subject_binding.user)
+        subject_binding.save(update_fields=['last_seen_at'])
+        return subject_binding.user, subject_binding, False
+
+    created = False
+    user = email_user
+    if user is None:
+        user = User(
+            username=email,
+            email=email,
+            first_name=firstname,
+            last_name=lastname,
+        )
+        user.save()
+        created = True
+
+    _require_active_user(user)
+    user_binding = KeycloakIdentityBinding.objects.select_for_update().filter(
+        issuer=issuer,
+        user=user,
+    ).first()
+    if user_binding is not None:
+        _validate_binding_pair(user_binding, user, issuer, subject)
+        user_binding.save(update_fields=['last_seen_at'])
+        return user, user_binding, created
+
+    try:
+        with transaction.atomic():
+            binding = KeycloakIdentityBinding.objects.create(
+                user=user,
+                issuer=issuer,
+                subject=subject,
+            )
+    except IntegrityError:
+        binding = KeycloakIdentityBinding.objects.select_for_update().filter(
+            issuer=issuer,
+            subject=subject,
+        ).first()
+        _validate_binding_pair(binding, user, issuer, subject)
+
+    return user, binding, created
+
+
+_SERIES_GROUP = re.compile(r'/pgeu/series/(?P<pk>[1-9][0-9]*)/roles/admin')
+_CONFERENCE_GROUP = re.compile(
+    r'/pgeu/conferences/(?P<conference>[a-z0-9_]+)/roles/'
+    r'(?P<role>admin|tester|talkvoter|staff|volunteer|checkin-processor)'
+)
+_WIKI_GROUP = re.compile(
+    r'/pgeu/conferences/(?P<conference>[a-z0-9_]+)/wiki/'
+    r'(?P<wiki>[A-Za-z0-9_-]+)/roles/(?P<role>viewer|editor)'
+)
+_SPONSOR_GROUP = re.compile(
+    r'/pgeu/sponsors/(?P<pk>[1-9][0-9]*)/roles/(?P<role>manager|badge-scanner)'
+)
+_MEETING_GROUP = re.compile(r'/pgeu/meetings/(?P<pk>[1-9][0-9]*)/roles/admin')
+
+
+_CONFERENCE_ROLE_GRANTS = {
+    'admin': ('pgeu-conference-admin', 'conference-admin'),
+    'tester': ('pgeu-conference-tester', 'conference-tester'),
+    'talkvoter': ('pgeu-conference-talkvoter', 'conference-talkvoter'),
+    'staff': ('pgeu-conference-staff', 'conference-staff'),
+    'volunteer': ('pgeu-conference-volunteer', 'conference-volunteer'),
+    'checkin-processor': ('pgeu-conference-checkin-processor', 'conference-checkin-processor'),
+}
+_WIKI_ROLE_GRANTS = {
+    'viewer': ('pgeu-wiki-viewer', 'wiki-viewer'),
+    'editor': ('pgeu-wiki-editor', 'wiki-editor'),
+}
+_SPONSOR_ROLE_GRANTS = {
+    'manager': ('pgeu-sponsor-manager', 'sponsor-manager'),
+    'badge-scanner': ('pgeu-sponsor-badge-scanner', 'sponsor-badge-scanner'),
+}
+_DIRECT_CONFERENCE_RELATIONS = {
+    'conference-admin': 'administrators',
+    'conference-tester': 'testers',
+    'conference-talkvoter': 'talkvoters',
+    'conference-staff': 'staff',
+}
+_REGISTRATION_CONFERENCE_RELATIONS = {
+    'conference-volunteer': 'volunteers',
+    'conference-checkin-processor': 'checkinprocessors',
+}
+
+
+def _parse_keycloak_group_path(path):
+    if not isinstance(path, str):
+        return None
+
+    match = _SERIES_GROUP.fullmatch(path)
+    if match:
+        return {
+            'client_role': 'pgeu-series-admin',
+            'grant_type': 'series-admin',
+            'pk': match.group('pk'),
+        }
+
+    match = _CONFERENCE_GROUP.fullmatch(path)
+    if match:
+        client_role, grant_type = _CONFERENCE_ROLE_GRANTS[match.group('role')]
+        return {
+            'client_role': client_role,
+            'grant_type': grant_type,
+            'conference': match.group('conference'),
+        }
+
+    match = _WIKI_GROUP.fullmatch(path)
+    if match:
+        client_role, grant_type = _WIKI_ROLE_GRANTS[match.group('role')]
+        return {
+            'client_role': client_role,
+            'grant_type': grant_type,
+            'conference': match.group('conference'),
+            'wiki': match.group('wiki'),
+        }
+
+    match = _SPONSOR_GROUP.fullmatch(path)
+    if match:
+        client_role, grant_type = _SPONSOR_ROLE_GRANTS[match.group('role')]
+        return {
+            'client_role': client_role,
+            'grant_type': grant_type,
+            'pk': match.group('pk'),
+        }
+
+    match = _MEETING_GROUP.fullmatch(path)
+    if match:
+        return {
+            'client_role': 'pgeu-meeting-admin',
+            'grant_type': 'meeting-admin',
+            'pk': match.group('pk'),
+        }
+
+    return None
+
+
+def _authorized_group_specs(roles, group_paths):
+    for path in sorted(group_paths, key=lambda value: str(value)):
+        spec = _parse_keycloak_group_path(path)
+        if spec is None:
+            log.warning("Ignoring malformed Keycloak pgeu_groups path: {0!r}".format(path))
+            continue
+        if spec['client_role'] not in roles:
+            log.warning(
+                "Ignoring Keycloak pgeu_groups path without required client role {0}: {1}".format(
+                    spec['client_role'],
+                    path,
+                )
+            )
+            continue
+        yield path, spec
+
+
+def _active_registration(user, conference, registration_pk=None):
+    registrations = ConferenceRegistration.objects.filter(
+        conference=conference,
+        attendee=user,
+        payconfirmedat__isnull=False,
+        canceledat__isnull=True,
+    )
+    if registration_pk is not None:
+        registrations = registrations.filter(pk=registration_pk)
+    return registrations.order_by('pk').first()
+
+
+def _badge_scanner_registration(user, sponsor, registration_pk=None):
+    if not sponsor.confirmed or not sponsor.conference.askbadgescan:
+        return None
+
+    if not SponsorClaimedBenefit.objects.filter(
+            sponsor=sponsor,
+            benefit__benefit_class=get_benefit_id('badgescanning.BadgeScanning'),
+            declined=False,
+            confirmed=True).exists():
+        return None
+
+    return _active_registration(user, sponsor.conference, registration_pk)
+
+
+def _resolve_keycloak_grant(user, path, spec):
+    grant_type = spec['grant_type']
+    relation_target = user.pk
+    relation_record = ''
+
+    if grant_type == 'series-admin':
+        target = ConferenceSeries.objects.filter(pk=spec['pk']).first()
+    elif grant_type in _DIRECT_CONFERENCE_RELATIONS:
+        target = Conference.objects.filter(urlname=spec['conference']).first()
+    elif grant_type in _REGISTRATION_CONFERENCE_RELATIONS:
+        target = Conference.objects.filter(urlname=spec['conference']).first()
+        registration = _active_registration(user, target) if target is not None else None
+        if registration is None:
+            target = None
+        else:
+            relation_target = registration.pk
+    elif grant_type in ('wiki-viewer', 'wiki-editor'):
+        target = Wikipage.objects.select_related('conference').filter(
+            conference__urlname=spec['conference'],
+            url=spec['wiki'],
+        ).first()
+        registration = _active_registration(user, target.conference) if target is not None else None
+        if registration is None:
+            target = None
+        else:
+            relation_target = registration.pk
+    elif grant_type in ('sponsor-manager', 'sponsor-badge-scanner'):
+        target = Sponsor.objects.select_related('conference').filter(pk=spec['pk']).first()
+        if grant_type == 'sponsor-badge-scanner' and target is not None:
+            registration = _badge_scanner_registration(user, target)
+            if registration is None:
+                target = None
+            else:
+                relation_target = registration.pk
+                scanner = SponsorScanner.objects.filter(sponsor=target, scanner=registration).first()
+                if scanner is not None:
+                    relation_record = str(scanner.pk)
+    elif grant_type == 'meeting-admin':
+        target = Meeting.objects.filter(pk=spec['pk']).first()
+        member = Member.objects.filter(user=user).first() if target is not None else None
+        if member is None:
+            target = None
+        else:
+            relation_target = member.pk
+    else:
+        target = None
+
+    if target is None:
+        log.warning("Ignoring Keycloak scoped grant with missing relationship prerequisites: {0}".format(path))
+        return None
+    return grant_type, str(target.pk), str(relation_target), relation_record
+
+
+def _desired_keycloak_grants(user, roles, group_paths):
+    desired = {}
+
+    for path, spec in _authorized_group_specs(roles, group_paths):
+        grant = _resolve_keycloak_grant(user, path, spec)
+        if grant is not None:
+            desired[(spec['client_role'], path)] = grant
+
+    return desired
+
+
+def _target_pk(target):
+    try:
+        return int(target)
+    except (TypeError, ValueError):
+        return None
+
+
+def _grant_exists(user, grant):
+    grant_type, target, relation_target, relation_record = grant
+
+    target_pk = _target_pk(target)
+    relation_pk = _target_pk(relation_target)
+    if target_pk is None or relation_pk is None:
+        return False
+
+    if grant_type == 'series-admin':
+        return ConferenceSeries.objects.filter(pk=target_pk, administrators__pk=relation_pk).exists()
+    if grant_type in _DIRECT_CONFERENCE_RELATIONS:
+        relation = _DIRECT_CONFERENCE_RELATIONS[grant_type]
+        conference = Conference.objects.filter(pk=target_pk).first()
+        return conference is not None and getattr(conference, relation).filter(pk=relation_pk).exists()
+    if grant_type in _REGISTRATION_CONFERENCE_RELATIONS:
+        relation = _REGISTRATION_CONFERENCE_RELATIONS[grant_type]
+        conference = Conference.objects.filter(pk=target_pk).first()
+        return conference is not None and getattr(conference, relation).filter(pk=relation_pk).exists()
+    if grant_type in ('wiki-viewer', 'wiki-editor'):
+        relation = 'viewer_attendee' if grant_type == 'wiki-viewer' else 'editor_attendee'
+        page = Wikipage.objects.filter(pk=target_pk).first()
+        return page is not None and getattr(page, relation).filter(pk=relation_pk).exists()
+    if grant_type == 'sponsor-manager':
+        return Sponsor.objects.filter(pk=target_pk, managers__pk=relation_pk).exists()
+    if grant_type == 'sponsor-badge-scanner':
+        relation_record_pk = _target_pk(relation_record)
+        return relation_record_pk is not None and SponsorScanner.objects.filter(
+            pk=relation_record_pk,
+            sponsor_id=target_pk,
+            scanner_id=relation_pk,
+        ).exists()
+    if grant_type == 'meeting-admin':
+        return Meeting.objects.filter(pk=target_pk, meetingadmins__pk=relation_pk).exists()
+    return False
+
+
+def _add_grant(user, grant):
+    grant_type, target, relation_target, relation_record = grant
+
+    target_pk = _target_pk(target)
+    relation_pk = _target_pk(relation_target)
+    if target_pk is None or relation_pk is None:
+        return None
+
+    if grant_type == 'series-admin':
+        if relation_pk != user.pk:
+            return None
+        series = ConferenceSeries.objects.filter(pk=target_pk).first()
+        if series is None:
+            return None
+        series.administrators.add(user)
+        return grant, True
+    if grant_type in _DIRECT_CONFERENCE_RELATIONS:
+        if relation_pk != user.pk:
+            return None
+        conference = Conference.objects.filter(pk=target_pk).first()
+        if conference is None:
+            return None
+        getattr(conference, _DIRECT_CONFERENCE_RELATIONS[grant_type]).add(user)
+        return grant, True
+    if grant_type in _REGISTRATION_CONFERENCE_RELATIONS:
+        conference = Conference.objects.filter(pk=target_pk).first()
+        if conference is None:
+            return None
+        registration = _active_registration(user, conference, relation_pk)
+        if registration is None:
+            return None
+        getattr(conference, _REGISTRATION_CONFERENCE_RELATIONS[grant_type]).add(registration)
+        return grant, True
+    if grant_type in ('wiki-viewer', 'wiki-editor'):
+        page = Wikipage.objects.select_related('conference').filter(pk=target_pk).first()
+        if page is None:
+            return None
+        registration = _active_registration(user, page.conference, relation_pk)
+        if registration is None:
+            return None
+        relation = 'viewer_attendee' if grant_type == 'wiki-viewer' else 'editor_attendee'
+        getattr(page, relation).add(registration)
+        return grant, True
+    if grant_type == 'sponsor-manager':
+        if relation_pk != user.pk:
+            return None
+        sponsor = Sponsor.objects.filter(pk=target_pk).first()
+        if sponsor is None:
+            return None
+        sponsor.managers.add(user)
+        return grant, True
+    if grant_type == 'sponsor-badge-scanner':
+        sponsor = Sponsor.objects.select_related('conference').filter(pk=target_pk).first()
+        if sponsor is None:
+            return None
+        registration = _badge_scanner_registration(user, sponsor, relation_pk)
+        if registration is None:
+            return None
+        scanner, created = SponsorScanner.objects.get_or_create(
+            sponsor=sponsor,
+            scanner=registration,
+            defaults={'token': generate_random_token()},
+        )
+        return (grant_type, target, relation_target, str(scanner.pk)), created
+    if grant_type == 'meeting-admin':
+        meeting = Meeting.objects.filter(pk=target_pk).first()
+        member = Member.objects.filter(pk=relation_pk, user=user).first()
+        if meeting is None or member is None:
+            return None
+        meeting.meetingadmins.add(member)
+        return grant, True
+    return None
+
+
+def _remove_grant(user, grant):
+    grant_type, target, relation_target, relation_record = grant
+
+    target_pk = _target_pk(target)
+    relation_pk = _target_pk(relation_target)
+    if target_pk is None or relation_pk is None:
+        return
+
+    if grant_type == 'series-admin':
+        series = ConferenceSeries.objects.filter(pk=target_pk).first()
+        if series is not None and relation_pk == user.pk:
+            series.administrators.remove(user)
+        return
+    if grant_type in _DIRECT_CONFERENCE_RELATIONS:
+        conference = Conference.objects.filter(pk=target_pk).first()
+        if conference is not None and relation_pk == user.pk:
+            getattr(conference, _DIRECT_CONFERENCE_RELATIONS[grant_type]).remove(user)
+        return
+    if grant_type in _REGISTRATION_CONFERENCE_RELATIONS:
+        conference = Conference.objects.filter(pk=target_pk).first()
+        registration = ConferenceRegistration.objects.filter(pk=relation_pk).first()
+        if conference is not None and registration is not None:
+            getattr(conference, _REGISTRATION_CONFERENCE_RELATIONS[grant_type]).remove(registration)
+        return
+    if grant_type in ('wiki-viewer', 'wiki-editor'):
+        page = Wikipage.objects.select_related('conference').filter(pk=target_pk).first()
+        registration = ConferenceRegistration.objects.filter(pk=relation_pk).first()
+        if page is not None and registration is not None:
+            relation = 'viewer_attendee' if grant_type == 'wiki-viewer' else 'editor_attendee'
+            getattr(page, relation).remove(registration)
+        return
+    if grant_type == 'sponsor-manager':
+        sponsor = Sponsor.objects.filter(pk=target_pk).first()
+        if sponsor is not None and relation_pk == user.pk:
+            sponsor.managers.remove(user)
+        return
+    if grant_type == 'sponsor-badge-scanner':
+        relation_record_pk = _target_pk(relation_record)
+        if relation_record_pk is None:
+            return
+        scanners = SponsorScanner.objects.filter(
+            pk=relation_record_pk,
+            sponsor_id=target_pk,
+            scanner_id=relation_pk,
+        )
+        if scanners.exists():
+            log.warning(
+                "Revoking Keycloak-owned sponsor badge scanner for user id {0}, registration id {1}; historical scans are retained".format(
+                    user.pk,
+                    relation_pk,
+                )
+            )
+            scanners.delete()
+        return
+    if grant_type == 'meeting-admin':
+        meeting = Meeting.objects.filter(pk=target_pk).first()
+        member = Member.objects.filter(pk=relation_pk).first()
+        if meeting is not None and member is not None:
+            meeting.meetingadmins.remove(member)
+
+
+def _plan_keycloak_grant_sync(current, desired, existing):
+    stale = {
+        claim
+        for claim, (grant, _owned) in current.items()
+        if claim not in desired or desired[claim] != grant
+    }
+    remove = {claim for claim in stale if current[claim][1]}
+    add = set(desired.keys()) - existing
+
+    resulting_ownership = {}
+    for claim in desired:
+        if claim not in existing:
+            resulting_ownership[claim] = True
+        elif claim in current and claim not in stale:
+            resulting_ownership[claim] = current[claim][1]
+        else:
+            resulting_ownership[claim] = False
+
+    return add, remove, stale, resulting_ownership
+
+
+@transaction.atomic
+def sync_keycloak_scoped_roles(binding, roles, group_paths):
+    user = binding.user
+    desired = _desired_keycloak_grants(user, roles, group_paths)
+    records = {
+        (record.client_role, record.group_path): record
+        for record in KeycloakRoleGrant.objects.select_for_update().filter(binding=binding)
+    }
+    current = {
+        claim: (
+            (record.grant_type, record.target, record.relation_target, record.relation_record),
+            record.owned,
+        )
+        for claim, record in records.items()
+    }
+    existing = {
+        claim
+        for claim, grant in desired.items()
+        if _grant_exists(user, grant)
+    }
+
+    add, remove, stale, resulting_ownership = _plan_keycloak_grant_sync(current, desired, existing)
+
+    for claim in sorted(remove):
+        _remove_grant(user, current[claim][0])
+    for claim in sorted(stale):
+        records[claim].delete()
+
+    failed = set()
+    for claim in sorted(add):
+        applied = _add_grant(user, desired[claim])
+        if applied is None:
+            failed.add(claim)
+            log.warning(
+                "Unable to apply Keycloak grant after relationship prerequisites changed: {0}:{1}".format(
+                    desired[claim][0],
+                    desired[claim][1],
+                )
+            )
+        else:
+            desired[claim], relation_created = applied
+            if not relation_created:
+                resulting_ownership[claim] = False
+
+    for claim in sorted(set(desired.keys()) - failed):
+        grant = desired[claim]
+        KeycloakRoleGrant.objects.update_or_create(
+            binding=binding,
+            client_role=claim[0],
+            group_path=claim[1],
+            defaults={
+                'grant_type': grant[0],
+                'target': grant[1],
+                'relation_target': grant[2],
+                'relation_record': grant[3],
+                'owned': resulting_ownership[claim],
+            },
+        )
+
+    for claim in failed:
+        KeycloakRoleGrant.objects.filter(
+            binding=binding,
+            client_role=claim[0],
+            group_path=claim[1],
+        ).delete()
